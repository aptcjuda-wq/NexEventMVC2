@using System.Linq
@model List<NexEventMVC2.Models.Event>

@{
    ViewData["Title"] = "Home";
}

<section class="bg-light py-5">
    <div class="container text-center">

        <span class="badge bg-warning text-dark mb-3">
            Discover Extraordinary Events
        </span>

        <h1 class="display-3 fw-bold">
            Where Moments Become
            <span class="text-primary">Memories</span>
        </h1>

        <p class="lead text-muted mt-3">
            Discover, book, and experience the world's finest events —
            from intimate workshops to grand festivals.
        </p>

        <div class="mt-4">
            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Browse Events
            </a>
        </div>

    </div>
</section>

<section class="py-5 border-top border-bottom">
    <div class="container">

        <div class="row text-center">

            <div class="col-md-3">
                <h2 class="text-primary">500+</h2>
                <p>Events Hosted</p>
            </div>

            <div class="col-md-3">
                <h2 class="text-primary">12,000+</h2>
                <p>Happy Attendees</p>
            </div>

            <div class="col-md-3">
                <h2 class="text-primary">9</h2>
                <p>Categories</p>
            </div>

            <div class="col-md-3">
                <h2 class="text-primary">25+</h2>
                <p>Cities</p>
            </div>

        </div>

    </div>
</section>
<section class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Featured Events</h2>
            <p class="text-muted">
                Handpicked experiences not to be missed
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-outline-primary">
            View All
        </a>

    </div>

    <div class="row">
        @foreach (var item in Model.Take(3))
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             class="card-img-top"
                             alt="@item.Title">
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Title
                        </h5>

                        <p class="text-muted">
                            @item.Venue
                        </p>

                        <p>
                            @item.Date.ToString("MMM dd, yyyy")
                        </p>

                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-primary">
                            View Details
                        </a>

                    </div>

                </div>

            </div>
        }
    </div>
</section>

<section class="bg-light py-5">

    <div class="container text-center">

        <h2>Browse by Category</h2>

        <p class="text-muted">
            Find the perfect event for your interests
        </p>

        <div class="mt-4">

            <span class="badge bg-primary m-1">Conference</span>

            <span class="badge bg-success m-1">Workshop</span>

            <span class="badge bg-danger m-1">Concert</span>

            <span class="badge bg-warning text-dark m-1">Festival</span>

            <span class="badge bg-info text-dark m-1">Networking</span>

            <span class="badge bg-secondary m-1">Sports</span>

        </div>

    </div>

</section>

<section class="py-5">

    <div class="container">

        <div class="bg-primary text-white rounded p-5 text-center">

            <h2>
                Ready to Host Your Event?
            </h2>

            <p class="mt-3">
                Join thousands of organizers who trust NexEvent.
            </p>

            <a asp-area="Identity"
               asp-page="/Account/Register"
               class="btn btn-light btn-lg mt-3">
                Get Started Free
            </a>

        </div>

    </div>

</section>