@model NexEventMVC2.Models.Event

<h1>Delete Event</h1>

<p>
    Are you sure you want to delete:
</p>

<h3>@Model.Title</h3>

<form asp-action="Delete">

    <input asp-for="Id" type="hidden" />

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>